    {
      "parameters": {
        "jsCode": "const inputItem = $input.first();\nconst rawHtml = inputItem.json.text || '';\n\n// Markdown kod bloklarını temizle\nlet cleanText = rawHtml\n  .replace(/```html/gi, '')\n  .replace(/```/g, '');\n\n// Style bloklarını ve HTML etiketlerini tamamen kaldır\ncleanText = cleanText\n  .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/\\n\\s*\\n+/g, '\\n\\n')\n  .trim();\n\nreturn [\n  {\n    json: {\n      ...inputItem.json,\n      clean_suggestion: cleanText\n    },\n    pairedItem: {\n      item: 0\n    }\n  }\n];"
      },
